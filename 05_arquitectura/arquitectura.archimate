        <property key="estado" value="se modifica" />
        <property key="brecha" value="B14" />
        <property key="ambito" value="actual" />
      </element>
      <element xsi:type="archimate:BusinessRole" name="Lector de medidores" id="id-7ca8145086815c5ab8fcd00591ad4963">
        <property key="ambito" value="actual y objetivo" />
      </element>
      <element xsi:type="archimate:BusinessProcess" name="P1 Catastro comercial de usuarios" id="id-8f519ed3b5c9540086f3ca80b344201e">
        <documentation>Soportado por el sistema comercial. Parcial: 3 100 conexiones con categoría tarifaria distinta entre catastro y facturación.</documentation>
        <property key="nivel_soporte" value="Parcial" />
        <property key="ambito" value="actual y objetivo" />
      </element>
      <element xsi:type="archimate:BusinessProcess" name="P2 Lectura de medidores y facturación" id="id-52f583dd53055fd7a2b489883fe02c90">
        <documentation>Micromedición y lectura + sistema comercial. Deficiente: archivo de carga sin trazabilidad; 11 200 conexiones facturadas por estimación en tres ciclos.</documentation>
        <property key="nivel_soporte" value="Deficiente" />
        <property key="ambito" value="actual y objetivo" />
      </element>
      <element xsi:type="archimate:BusinessProcess" name="P3 Cobranza y corte/reconexión" id="id-53ff2e0317fa550db1661bc1137da517">
        <documentation>Sistema comercial. Parcial: la recaudación se digita a mano en el SIAF.</documentation>
        <property key="nivel_soporte" value="Parcial" />
        <property key="ambito" value="actual y objetivo" />
      </element>
      <element xsi:type="archimate:BusinessProcess" name="P4 Atención de reclamos comerciales" id="id-4e91e9d23afb51f3b0ea658f644db300">
        <documentation>Formulario web + hoja de cálculo, sin soporte desde 2021; plazos distintos entre libro y reporte a SUNASS.</documentation>
        <property key="nivel_soporte" value="Deficiente" />
        <property key="ambito" value="actual y objetivo" />
      </element>
      <element xsi:type="archimate:BusinessProcess" name="P5 Operación de plantas y redes" id="id-786f60f1e07f589fae4ec98731a58f65">
        <documentation>SCADA con soporte vigente. El riesgo está en la red (capa de tecnología), no en el soporte aplicativo.</documentation>
        <property key="nivel_soporte" value="Bueno" />
        <property key="ambito" value="actual y objetivo" />
      </element>
      <element xsi:type="archimate:BusinessProcess" name="P6 Contrataciones y presupuesto público" id="id-66fa891911a25b159a774eb2f670e153">
        <documentation>SIAF y patrimonio (MEF), con soporte del MEF.</documentation>
        <property key="nivel_soporte" value="Bueno" />
        <property key="ambito" value="actual y objetivo" />
      </element>
      <element xsi:type="archimate:BusinessProcess" name="P7 Conciliación catastro–facturación (mensual)" id="id-dd7f5cd55faa5365a65da310f7e73a86">
        <documentation>Proceso que corre sobre una hoja de cálculo sin soporte, mantenida por un área por su cuenta.</documentation>
        <property key="nivel_soporte" value="Deficiente" />
        <property key="ambito" value="actual y objetivo" />
      </element>
      <element xsi:type="archimate:BusinessProcess" name="P8 Informe de indicadores para SUNASS" id="id-0c1ff1a27f5c54e8b15fda1ca55665cf">
        <documentation>Hoja de cálculo manual, sin versionado, calculada sobre fuentes con discrepancias.</documentation>
        <property key="nivel_soporte" value="Deficiente" />
        <property key="ambito" value="actual y objetivo" />
      </element>
      <element xsi:type="archimate:BusinessProcess" name="P9 Gestión de incidentes y seguridad de la información" id="id-2678b74698d05b4b91b0dd9b7f1aa973">
        <documentation>Registro de incidentes por correo, sin clasificación ni tiempos; no existe política de seguridad (FICHA F).</documentation>
        <property key="nivel_soporte" value="Sin soporte" />
        <property key="ambito" value="actual y objetivo" />
      </element>
      <element xsi:type="archimate:BusinessService" name="Suministro de agua potable y alcantarillado" id="id-f989ad4ca9c05f268d6c2a1ce25d3cdb">
        <property key="ambito" value="actual y objetivo" />
      </element>
